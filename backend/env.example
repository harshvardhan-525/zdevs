# Server
PORT=3000

# Supabase: Project Settings -> API
# Use the Project URL and the anon / publishable key. Never put the service_role key here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Only needed if the frontend is opened from a different origin than this server
# (for example VS Code Live Server). Comma separated, no trailing slashes.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
